<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MarkMello.Presentation.ViewModels"
             x:Class="MarkMello.Presentation.Views.CloseConfirmationSettingsView"
             x:DataType="vm:ShellViewModel">
  <StackPanel Spacing="0">
    <Line Classes="mm-setting-divider" StartPoint="0,0.5" EndPoint="1,0.5" />
    <Border Classes="mm-setting-row">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="mm-setting-label" TextWrapping="Wrap" Text="{Binding ConfirmBeforeCloseLabel}" />
          <TextBlock Classes="mm-setting-hint" TextWrapping="Wrap" Text="{Binding ConfirmBeforeCloseHint}" />
        </StackPanel>
        <CheckBox Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding ConfirmBeforeClose, Mode=TwoWay}" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
