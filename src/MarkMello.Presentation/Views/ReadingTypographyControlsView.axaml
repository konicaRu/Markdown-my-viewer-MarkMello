<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MarkMello.Presentation.ViewModels"
             x:Class="MarkMello.Presentation.Views.ReadingTypographyControlsView"
             x:DataType="vm:ShellViewModel">
  <StackPanel Spacing="0">
    <StackPanel Spacing="0">
      <Line Classes="mm-setting-divider"
            StartPoint="0,0.5"
            EndPoint="1,0.5" />
      <Border Classes="mm-setting-row">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <StackPanel Grid.Column="0"
                      Spacing="2"
                      VerticalAlignment="Center">
            <TextBlock Classes="mm-setting-label"
                       Text="{Binding ReadingSizeLabel}" />
            <TextBlock Classes="mm-setting-hint"
                       TextWrapping="Wrap"
                       Text="{Binding ReadingSizeHint}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="10"
                      VerticalAlignment="Center">
            <Slider Classes="mm-settings-slider"
                    Minimum="14"
                    Maximum="24"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Value="{Binding FontSizeSetting, Mode=TwoWay}" />
            <TextBlock Classes="mm-slider-value"
                       Text="{Binding FontSizeLabel}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <StackPanel Spacing="0">
      <Line Classes="mm-setting-divider"
            StartPoint="0,0.5"
            EndPoint="1,0.5" />
      <Border Classes="mm-setting-row">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <StackPanel Grid.Column="0"
                      Spacing="2"
                      VerticalAlignment="Center">
            <TextBlock Classes="mm-setting-label"
                       Text="{Binding ReadingLineHeightLabel}" />
            <TextBlock Classes="mm-setting-hint"
                       TextWrapping="Wrap"
                       Text="{Binding ReadingLineHeightHint}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="10"
                      VerticalAlignment="Center">
            <Slider Classes="mm-settings-slider"
                    Minimum="1.2"
                    Maximum="2.0"
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="True"
                    Value="{Binding LineHeightSetting, Mode=TwoWay}" />
            <TextBlock Classes="mm-slider-value"
                       Text="{Binding LineHeightLabel}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>


  </StackPanel>
</UserControl>
